<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:cardElevation="4dp"
            android:layout_margin="12dp"
            app:cardCornerRadius="10dp"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:focusable="true"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:padding="6dp"
                    android:textAlignment="center"
                    android:textSize="23sp"
                    android:textColor="@color/gray"
                    android:textStyle="bold"
                    android:text="Create Food"
                    />

                <EditText
                    android:id="@+id/foodNameIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_food_name"
                    android:textSize="18sp"
                    android:inputType="text"
                    android:padding="12dp"
                    android:paddingBottom="30dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/editBackGroundColor"
                    android:textColor="@color/black"
                    android:textColorHint="@color/material_dynamic_neutral60"
                    />
                <EditText
                    android:id="@+id/foodCategoryIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/enter_category"
                    android:textSize="18sp"
                    android:paddingBottom="30dp"
                    android:inputType="text"
                    android:padding="12dp"
                    android:backgroundTint="@color/editBackGroundColor"
                    android:textColor="@color/black"
                    android:textColorHint="@color/material_dynamic_neutral60"
                    />
                <EditText
                    android:id="@+id/foodCaloriesIn"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_calories"
                    android:textSize="18sp"
                    android:textStyle="normal"
                    android:inputType="number"
                    android:padding="12dp"
                    android:backgroundTint="@color/editBackGroundColor"
                    android:textColor="@color/black"
                    android:textColorHint="@color/material_dynamic_neutral60"
                    />
                <EditText
                    android:id="@+id/foodFiberIn"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_fiber"
                    android:textSize="18sp"
                    android:textStyle="normal"
                    android:inputType="number"
                    android:padding="12dp"
                    android:backgroundTint="@color/editBackGroundColor"
                    android:textColor="@color/black"
                    android:textColorHint="@color/material_dynamic_neutral60"
                    />
                <EditText
                    android:id="@+id/foodProteinsIn"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_proteins"
                    android:textSize="18sp"
                    android:textStyle="normal"
                    android:inputType="number"
                    android:padding="12dp"
                    android:backgroundTint="@color/editBackGroundColor"
                    android:textColor="@color/black"
                    android:textColorHint="@color/material_dynamic_neutral60"
                    />

                <Button
                    android:id="@+id/submitBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/submit"
                    android:textColor="@color/white"/>
                <Button
                    android:id="@+id/navToListBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Go to List View"
                    android:backgroundTint="@color/nonSubmitBtnColor"
                    />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>