<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardElevation="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/purple_700"
                android:textAlignment="center"
                android:hint="Food Entity Creation"
                android:layout_marginBottom="18dp" />
            <EditText
                android:id="@+id/f_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:hint="Enter Food Name"
                android:textSize="16sp"
                android:backgroundTint="@color/black"
                />
            <EditText
                android:id="@+id/f_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:hint="Enter cateogry"
                android:textColor="@color/black"
                android:textSize="16sp"/>
            <EditText
                android:id="@+id/f_calories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="Enter calories"
                android:textColor="@color/black"
                android:textSize="16sp"/>
            <EditText
                android:id="@+id/f_fibres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="Enter fibres"
                android:textColor="@color/black"
                android:textSize="16sp"/>
            <LinearLayout
                android:id="@+id/buttonContainer"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/submitBtn"
                    app:layout_constraintStart_toStartOf="@+id/buttonContainer"
                    app:layout_constraintEnd_toEndOf="@+id/buttonContainer"
                    android:layout_width="wrap_content"
                    android:text="Submit"

                    android:layout_marginEnd="12dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:id="@+id/navBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Go to List view"/>
            </LinearLayout>

        </LinearLayout>



    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>